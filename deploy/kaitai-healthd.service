[Unit]
Description=kaitai-healthd — 开台 IPTV 全量频道健康巡检
Documentation=https://iptv.wusi321.top/
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/kaitai-health/healthd.py
Environment=KAITAI_PLAYLIST=/var/www/iptv/playlists/kaitai-0x152k.m3u
Environment=KAITAI_HEALTH_OUT=/var/www/iptv/health.json
Environment=KAITAI_OTHER_WORKERS=3
Environment=KAITAI_RETRY_GAP=0.5
Environment=KAITAI_TIMEOUT=8
# 一轮约 6 分钟，再歇 3 分钟：平均每条约 9 分钟刷新一次，
# 刻意留出空闲，避免长期占满各源站对机房 IP 的请求配额
Environment=KAITAI_INTERVAL=180
Restart=always
RestartSec=15
Nice=10

[Install]
WantedBy=multi-user.target
